# ==============================================================================
# Datédex Public App Environment Variables Template (.env.example)
# NEVER commit .env or .env.local. Only public publishable vars may use VITE_*.
# ==============================================================================

# --- Client-Safe Public Variables (Vite) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key_here
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_BANNER_SLOT=
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# --- Server-Only Variables (Vercel Project Settings ONLY — NEVER prefix VITE_) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_vercel_server_only_service_role_key
GEMINI_API_KEY=replace_with_vercel_server_only_gemini_api_key
STRIPE_SECRET_KEY=replace_with_vercel_server_only_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_vercel_server_only_stripe_webhook_secret
STRIPE_PRO_PRICE_ID=price_replace_with_2_99_eur_monthly_price_id
APP_URL=https://your-datedex-domain.vercel.app
