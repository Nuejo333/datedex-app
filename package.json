{
  "name": "datedex-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Datédex — Track Your Dating Journey (Public Consumer PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit",
    "lint": "eslint .",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "ci": "npm run typecheck && npm run lint && npm run check:boundaries && npm run test && npm run check:secrets && npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@supabase/supabase-js": "^2.49.4",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^4.2.0",
    "lucide-react": "^0.511.0",
    "mapbox-gl": "^3.36.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^18.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vercel/node": "^5.1.12",
    "@vitejs/plugin-react": "^4.4.1",
    "dependency-cruiser": "^16.10.3",
    "eslint": "^9.26.0",
    "eslint-plugin-jsdoc": "^50.6.11",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.3"
  }
}
